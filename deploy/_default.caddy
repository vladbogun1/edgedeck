# ---------------------------------------------------------------------------
#  Обработчик по умолчанию: всё, для чего нет отдельного файла в sites/,
#  уходит в панель EdgeDeck.
#
#  Что это даёт: направил A-запись на сервер, открыл домен — попал в панель и
#  сразу видишь этот домен в списке «пришли, но не настроены». Как только для
#  него появится свой файл в sites/, домен уйдёт на сайт: явный адрес всегда
#  выигрывает у этой заглушки.
#
#  Файл называется _default, чтобы грузиться первым (import идёт по алфавиту).
#  Ставится установщиком EdgeDeck; правится вместе с ним.
# ---------------------------------------------------------------------------

# HTTP: и панель, и проверки ACME. Редиректа на https здесь нет намеренно —
# по IP валидного сертификата не будет, а панель должна открываться и так.
:80 {
	reverse_proxy edgedeck:4000 {
		header_up X-Real-IP {remote_host}
	}
	log {
		output file /var/log/caddy/edgedeck.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
}

# HTTPS для любого домена, у которого нет своего файла. Сертификат выпускается
# на месте (on_demand), разрешение спрашивается у панели — см. блок on_demand_tls
# в Caddyfile.
https:// {
	tls {
		on_demand
	}
	reverse_proxy edgedeck:4000 {
		header_up X-Real-IP {remote_host}
	}
	log {
		output file /var/log/caddy/edgedeck.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
}

# Заход по IP: Let's Encrypt для адресов сертификатов не выдаёт, поэтому здесь
# свой, самоподписанный. Браузер предупредит — это ожидаемо.
https://__SERVER_IP__ {
	tls internal
	reverse_proxy edgedeck:4000 {
		header_up X-Real-IP {remote_host}
	}
}
